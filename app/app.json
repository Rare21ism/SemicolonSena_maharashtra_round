{
  "expo": {
    "name": "Roundtable",
    "slug": "roundtable",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "roundtable",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
